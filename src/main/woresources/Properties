# WebObjects side configuration. ng-objects reads nothing from this file.

# Serve through the Jetty-based WOAdaptor. This is what lets wong.Application supply the Jetty server that both
# frameworks share (see Application.createJettyServer()). Can also be passed as a launch argument: -WOAdaptor WOAdaptorJetty
WOAdaptor=WOAdaptorJetty

# Register with the Parslips dev server (if one is running) so the app shows up in http://localhost:9485/apps
wolips.host=localhost
wolips.port=9485

# Logging: a console appender with a wall-clock timestamp
log4j.loggerFactory=er.extensions.logging.ERXLogger$Factory
log4j.rootCategory=INFO, A1
log4j.appender.A1=org.apache.log4j.ConsoleAppender
log4j.appender.A1.layout=er.extensions.logging.ERXPatternLayout
log4j.appender.A1.layout.ConversionPattern=%d{MMM dd HH:mm:ss} %-5p %c - %m%n
